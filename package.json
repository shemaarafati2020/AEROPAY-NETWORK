{
  "name": "aeropay-network-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "start": "npm --workspace=frontend run start",
    "web": "npm --workspace=frontend run web",
    "android": "npm --workspace=frontend run android",
    "ios": "npm --workspace=frontend run ios",
    "build:frontend": "npm --workspace=frontend run build:web",
    "lint": "npm --workspace=frontend run lint",
    "type-check": "npm --workspace=frontend run type-check",
    "backend:build": "cd backend && mvn clean package -DskipTests",
    "backend:test": "cd backend && mvn clean test",
    "backend:run": "cd backend && mvn spring-boot:run",
    "compose:up": "docker compose up --build -d",
    "compose:down": "docker compose down",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.9.6"
  }
}
