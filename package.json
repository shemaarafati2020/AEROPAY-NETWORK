{
  "name": "aeropay-network-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run start --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build:frontend": "npm run build:web --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build": "npm run build:backend",
    "lint:frontend": "npm run lint --workspace=frontend",
    "type-check:frontend": "npm run type-check --workspace=frontend",
    "type-check:backend": "npm run type-check --workspace=backend",
    "lint": "npm run lint:frontend",
    "type-check": "npm run type-check:frontend && npm run type-check:backend",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.9.6"
  }
}
