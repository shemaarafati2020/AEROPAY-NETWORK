{
  "name": "aeropay-network-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "npm --prefix frontend run start",
    "web": "npm --prefix frontend run web",
    "android": "npm --prefix frontend run android",
    "ios": "npm --prefix frontend run ios",
    "build:frontend": "npm --prefix frontend run build:web",
    "lint": "npm --prefix frontend run lint",
    "type-check": "npm --prefix frontend run type-check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:build": "docker build -t aeropay-frontend ./frontend",
    "docker:run": "docker run -p 8080:80 aeropay-frontend",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.9.6"
  }
}
